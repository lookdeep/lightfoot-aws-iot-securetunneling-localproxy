FROM ubuntu:noble

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt upgrade -y && \
    apt-get install --no-install-recommends -y --no-remove \
        autoconf \
        autoconf-archive \
        bash \
        bc \
        bison \
        build-essential \
        ccache \
        cmake \
        cpio \
        devscripts \
        debhelper \
        dh-exec \
        dpkg-dev \
        fakeroot \
        flex \
        git \
        git-buildpackage \
        git-lfs \
        kmod \
        libelf-dev \
        libssl-dev \
        openssh-client \
        pristine-lfs \
        rsync \
        sudo \
        systemd \
	wget \
	zlib1g

